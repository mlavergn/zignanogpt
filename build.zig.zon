        .zigvaxis = .{
            .path = "../../inferise/zigvaxis",
            .clone = "git@github.com:inferise/zigvaxis.git",
        },
        // Pinned to the commit zigvaxis uses; one module serves both, built
        // with the union of the fields each needs (see build.zig).
        .uucode = .{
            .url = "git+https://github.com/jacobsandlund/uucode#2826a37a4562284fdacd8fa029d49509cc9bffcd",
